<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05080A"
    tools:context=".MainActivity">

    <com.example.wifeye.SignalVisualizerView
        android:id="@+id/visualizer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/controlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="#990A1A1A">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SYSTEM: ONLINE"
            android:textColor="#00FF00"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <Spinner
            android:id="@+id/modeSpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="140dp"
            android:backgroundTint="#00FF00"
            android:layout_marginEnd="12dp"/>

        <Button
            android:id="@+id/recalibrateButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="RECAL"
            android:textSize="10sp"
            android:backgroundTint="#004400"
            android:textColor="#00FF00"
            android:padding="0dp"
            android:fontFamily="monospace" />

    </LinearLayout>

    <!-- Hidden standard texts for logical processing -->
    <TextView android:id="@+id/movementText" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" tools:ignore="MissingConstraints" />
    <TextView android:id="@+id/rssiText" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" tools:ignore="MissingConstraints" />

</androidx.constraintlayout.widget.ConstraintLayout>