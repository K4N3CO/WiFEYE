<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05080A"
    tools:context=".MainActivity">

    <com.example.wifeye.SignalVisualizerView
        android:id="@+id/visualizer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/controlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="#990A1A1A">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM: ONLINE"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/azimuthText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AZIMUTH: 0°"
                android:textColor="#8800FF00"
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <Spinner
            android:id="@+id/modeSpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="140dp"
            android:backgroundTint="#00FF00"
            android:layout_marginEnd="12dp"/>

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_manage"
            android:background="#004400"
            app:tint="#00FF00"
            android:scaleType="centerInside"
            android:contentDescription="Settings" />

    </LinearLayout>

    <!-- Hidden standard texts for logical processing -->
    <TextView android:id="@+id/movementText" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" tools:ignore="MissingConstraints" />
    <TextView android:id="@+id/rssiText" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" tools:ignore="MissingConstraints" />

</androidx.constraintlayout.widget.ConstraintLayout>