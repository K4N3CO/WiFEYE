<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#10151A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TACTICAL OVERRIDE"
        android:textColor="#00FF00"
        android:textSize="18sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SENSITIVITY (CUSUM)"
        android:textColor="#888888"
        android:textSize="12sp"
        android:fontFamily="monospace"/>

    <SeekBar
        android:id="@+id/sensitivitySeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="50"
        android:layout_marginTop="8dp"
        android:progressTint="#00FF00"
        android:thumbTint="#00FF00"/>

    <CheckBox
        android:id="@+id/audioToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GEIGER AUDIO FEED"
        android:textColor="#FFFFFF"
        android:buttonTint="#00FF00"
        android:fontFamily="monospace"
        android:layout_marginTop="16dp"
        android:checked="true"/>

    <CheckBox
        android:id="@+id/hapticToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TACTICAL HAPTICS"
        android:textColor="#FFFFFF"
        android:buttonTint="#00FF00"
        android:fontFamily="monospace"
        android:layout_marginTop="12dp"
        android:checked="true"/>

    <CheckBox
        android:id="@+id/scanlineToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HUD SCANLINES"
        android:textColor="#FFFFFF"
        android:buttonTint="#00FF00"
        android:fontFamily="monospace"
        android:layout_marginTop="12dp"
        android:checked="true"/>

    <Button
        android:id="@+id/closeSettingsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="APPLY &amp; CLOSE"
        android:backgroundTint="#004400"
        android:textColor="#00FF00"
        android:layout_marginTop="32dp"
        android:fontFamily="monospace"/>

</LinearLayout>
